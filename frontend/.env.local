# Backend API - Docker container turtlebot3-ba on port 8082
VITE_API_URL=http://localhost:8082/api
VITE_WS_URL=/ws/robot
VITE_DEV_BACKEND_TARGET=http://localhost:8082

# ROS Bridge - Uses Vite proxy to route to Docker containers
# /rosbridge -> ws://localhost:9092 (tb3-rosbridge container)
# /rosbridge-soarm -> ws://localhost:9092 (shared, or use 9093 if so-arm container is running)
VITE_ROSBRIDGE_URL=/rosbridge